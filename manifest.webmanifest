{
  "name": "TopoMaroc GIS",
  "short_name": "TopoMaroc",
  "description": "SIG topographique de terrain pour le Maroc : Lambert Maroc, GPS, levés, superficies.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./#/home",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f3d5e",
  "theme_color": "#0f3d5e",
  "categories": ["navigation", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Aller à un point", "url": "./#/nav", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Levé", "url": "./#/survey", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Parcelles", "url": "./#/parcels", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
